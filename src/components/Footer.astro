---
import { Image } from "astro:assets";
import ticlatLogo from "../assets/images/ticlat-logo-official.png";

const footerLinks = [
  { label: "Inicio", href: "#inicio" },
  { label: "Nosotros", href: "#nosotros" },
  { label: "Servicios", href: "#servicios" },
  { label: "Proyectos", href: "#proyectos" },
  { label: "Contacto", href: "#contacto" },
];
---

<footer class="site-footer">
  <div class="footer-gridline" aria-hidden="true"></div>
  <div class="footer-inner">
    <div class="footer-main" data-reveal>
      <a class="brand brand--footer" href="#inicio" aria-label="TICLAT, ir al inicio">
        <Image class="brand-logo" src={ticlatLogo} alt="TICLAT" width={280} height={70} />
      </a>
      <p>Infraestructura que hace posible cada proyecto.</p>
      <a class="footer-email" href="#contacto">Hablemos de tu proyecto <span aria-hidden="true">↗</span></a>
      <nav class="footer-social" aria-label="Redes sociales">
        <p class="footer-label">Síguenos</p>
        <div class="footer-social__links">
          <a href="https://www.linkedin.com/company/ticlat/home/" target="_blank" rel="noopener noreferrer" aria-label="TICLAT en LinkedIn">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M7 10v7M7 7v.01M11 17v-4a3 3 0 0 1 6 0v4M11 10v7" /></svg>
            <span>LinkedIn</span>
          </a>
          <a href="https://www.instagram.com/ticlatsas/" target="_blank" rel="noopener noreferrer" aria-label="TICLAT en Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.3" cy="6.7" r="1" class="footer-social__dot" /></svg>
            <span>Instagram</span>
          </a>
          <a href="https://www.tiktok.com/@ticlat.sas?_t=8sabazt4lbp&amp;_r=1" target="_blank" rel="noopener noreferrer" aria-label="TICLAT en TikTok">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4v10.2a4.3 4.3 0 1 1-3.2-4.16v3.1a1.4 1.4 0 1 0 1.1 1.36V4h2.1c.3 1.5 1.25 2.6 2.9 3.1v2.2A6.4 6.4 0 0 1 14 8.15V4Z" /></svg>
            <span>TikTok</span>
          </a>
          <a href="https://www.facebook.com/profile.php?id=100027869180455&amp;mibextid=ZbWKwL" target="_blank" rel="noopener noreferrer" aria-label="TICLAT en Facebook">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21v-8h2.7l.4-3h-3.1V8.1c0-.87.24-1.46 1.5-1.46h1.7V4a22 22 0 0 0-2.48-.13c-2.46 0-4.14 1.5-4.14 4.25V10H7.3v3h2.78v8h3.42Z" /></svg>
            <span>Facebook</span>
          </a>
        </div>
      </nav>
    </div>

    <div class="footer-column" data-reveal>
      <p class="footer-label">Explora</p>
      <nav aria-label="Enlaces del footer">
        {footerLinks.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </div>

    <div class="footer-column" data-reveal>
      <p class="footer-label">TICLAT S.A.S.</p>
      <p class="footer-copy">Tecnología Infraestructura y Comunicaciones Latorre S.A.S.</p>
      <p class="footer-copy">Bogotá D.C. · Colombia<br />NIT 900858320-1</p>
    </div>
  </div>

  <div class="footer-bottom">
    <span>© <span data-current-year>2026</span> TICLAT S.A.S. Todos los derechos reservados.</span>
    <span>Ingeniería · Infraestructura · Ejecución · Confianza</span>
  </div>
</footer>
