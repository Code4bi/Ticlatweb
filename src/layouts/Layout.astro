---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "TICLAT | Ingeniería e infraestructura eléctrica",
  description = "Diseñamos, ejecutamos y acompañamos proyectos eléctricos y de infraestructura para espacios comerciales, empresariales e industriales.",
} = Astro.props;

const siteUrl = Astro.site ?? new URL("http://localhost:4321");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl.href}#organization`,
      name: "TICLAT S.A.S.",
      legalName: "Tecnología Infraestructura y Comunicaciones Latorre S.A.S.",
      url: siteUrl.href,
      foundingDate: "2015",
      address: { "@type": "PostalAddress", addressLocality: "Bogotá D.C.", addressCountry: "CO" },
      identifier: "900858320-1",
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl.href}#website`,
      url: siteUrl.href,
      name: "TICLAT",
      publisher: { "@id": `${siteUrl.href}#organization` },
      inLanguage: "es-CO",
    },
    {
      "@type": "WebPage",
      url: canonicalUrl.href,
      name: title,
      description,
      isPartOf: { "@id": `${siteUrl.href}#website` },
      about: { "@id": `${siteUrl.href}#organization` },
      inLanguage: "es-CO",
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d2638" />
    <meta name="description" content={description} />
    <meta name="author" content="TICLAT S.A.S." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl.href} />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="TICLAT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;500;600;700&family=Montserrat:wght@500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      function initReveals() {
        const elements = document.querySelectorAll<HTMLElement>("[data-reveal]");
        if (!elements.length) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
        );

        elements.forEach((element, index) => {
          element.style.setProperty("--reveal-delay", `${Math.min(index % 6, 5) * 70}ms`);
          observer.observe(element);
        });
      }

      initReveals();
      document.addEventListener("astro:page-load", initReveals);

      const year = document.querySelector<HTMLElement>("[data-current-year]");
      if (year) year.textContent = String(new Date().getFullYear());
    </script>
  </body>
</html>
