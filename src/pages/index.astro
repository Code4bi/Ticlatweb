---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import heroImage from "../assets/images/ticlat-hero.jpg";
import retailImage from "../assets/images/ticlat-retail.jpg";
import engineeringImage from "../assets/images/ticlat-engineering.jpg";
import spaceImage from "../assets/images/ticlat-space.jpg";
import installationsImage from "../assets/images/ticlat-installations.jpg";
import networkImage from "../assets/images/ticlat-network.jpg";
import maintenanceImage from "../assets/images/ticlat-maintenance.jpg";
import teamImage from "../assets/images/ticlat-team.jpg";

const services = [
  {
    number: "01",
    title: "Instalaciones eléctricas",
    text: "Ejecutamos infraestructura eléctrica para proyectos comerciales, empresariales e industriales, desde la canalización hasta la puesta en funcionamiento.",
    image: installationsImage,
    icon: "M12 3v18M5 7h14M5 17h14M7 7v10M17 7v10",
  },
  {
    number: "02",
    title: "Infraestructura para retail",
    text: "Acompañamos adecuaciones, aperturas y remodelaciones, coordinando la infraestructura que cada espacio necesita para entrar en operación.",
    image: retailImage,
    icon: "M4 20V8l8-5 8 5v12M8 20v-6h8v6M3 20h18",
  },
  {
    number: "03",
    title: "Redes y cableado",
    text: "Implementamos canalizaciones, bandejas, cableado e infraestructura física para redes de comunicación y datos.",
    image: networkImage,
    icon: "M5 12h14M12 5v14M7 7l10 10M17 7 7 17",
  },
  {
    number: "04",
    title: "Ingeniería y planeación",
    text: "Analizamos requerimientos, planos, materiales y condiciones de ejecución para transformar necesidades en proyectos organizados.",
    image: engineeringImage,
    icon: "M5 19 19 5M6 6h.01M18 18h.01M7 17h10M7 7h4",
  },
  {
    number: "05",
    title: "Adecuaciones y mantenimiento",
    text: "Intervenimos, ampliamos, reorganizamos y mantenemos infraestructura para conservar los espacios seguros y operativos.",
    image: maintenanceImage,
    icon: "M14.5 6.5a4 4 0 0 0-5 5L4 17l3 3 5.5-5.5a4 4 0 0 0 5-5L15 12l-3-3 2.5-2.5Z",
  },
  {
    number: "06",
    title: "Acompañamiento de proyectos",
    text: "Coordinamos las etapas de ejecución con seguimiento técnico, control de actividades y comunicación permanente.",
    image: teamImage,
    icon: "M4 6h16M4 12h16M4 18h10M8 3v6M16 9v6M10 15v6",
  },
];

const projects = [
  {
    title: "MINISO — Tienda #100 Colombia",
    location: "Ibagué, Colombia",
    category: "Retail · Infraestructura eléctrica",
    text: "Participación en la ejecución de la obra eléctrica correspondiente a la apertura de la tienda número 100 de MINISO en Colombia.",
    image: retailImage,
    size: "project-card--large",
  },
  {
    title: "MINISO Parque Alegra",
    location: "Barranquilla, Colombia",
    category: "Retail · Instalaciones eléctricas",
    text: "Proyecto de infraestructura eléctrica desarrollado para un nuevo espacio comercial.",
    image: engineeringImage,
    size: "",
  },
  {
    title: "D1 86 Once",
    location: "Bogotá, Colombia",
    category: "Retail · Instalaciones eléctricas",
    text: "Instalaciones eléctricas desarrolladas para la adecuación de un espacio comercial.",
    image: spaceImage,
    size: "",
  },
];

const process = [
  { number: "01", title: "Entendemos", text: "Analizamos el proyecto, el espacio y sus requerimientos técnicos." },
  { number: "02", title: "Planeamos", text: "Definimos recursos, actividades, materiales y condiciones de ejecución." },
  { number: "03", title: "Ejecutamos", text: "Desarrollamos las instalaciones con seguimiento técnico y coordinación." },
  { number: "04", title: "Verificamos", text: "Revisamos la correcta terminación y funcionamiento de lo ejecutado." },
  { number: "05", title: "Entregamos", text: "Dejamos la infraestructura preparada para acompañar la operación." },
];
---

<Layout>
  <section class="hero" id="inicio">
    <Image
      src={heroImage}
      alt="Interior comercial en construcción con infraestructura eléctrica organizada"
      class="hero__image"
      widths={[768, 1280, 1672]}
      sizes="100vw"
      format="webp"
      quality={78}
      loading="eager"
    />
    <div class="hero__overlay"></div>
    <div class="hero__technical" aria-hidden="true">
      <span>BOG / 04°42'N</span>
      <span class="hero__technical-line"></span>
      <span>2025 — 2026</span>
    </div>
    <div class="hero__rail" aria-hidden="true"><span>INGENIERÍA</span><span>INFRAESTRUCTURA</span><span>EJECUCIÓN</span><span>CONFIANZA</span></div>

    <div class="container hero__content">
      <div class="hero__eyebrow"><span class="status-dot"></span> Ingeniería e infraestructura eléctrica</div>
      <h1>Infraestructura<br /><em>que hace posible</em><br />cada proyecto.</h1>
      <p class="hero__intro">Desarrollamos soluciones eléctricas y de infraestructura para espacios comerciales, empresariales e industriales, acompañando cada proyecto desde la planeación hasta su ejecución.</p>
      <div class="hero__actions">
        <a class="button button--accent" href="#contacto">Cotiza tu proyecto <span aria-hidden="true">↗</span></a>
        <a class="text-link text-link--light" href="#proyectos">Ver proyectos <span aria-hidden="true">↓</span></a>
      </div>
    </div>

    <div class="hero__bottom container">
      <span class="hero__scroll"><i></i> Desliza para explorar</span>
      <span class="hero__index">01 <b>/</b> 06</span>
    </div>
  </section>

  <section class="trust-strip" aria-label="Experiencia y alcance de Ticlat">
    <div class="container trust-strip__inner">
      <div><span class="trust-strip__number">10+</span><span>años desarrollando<br />infraestructura</span></div>
      <div><span class="trust-icon">↗</span><span>Proyectos comerciales<br />y empresariales</span></div>
      <div><span class="trust-icon">⌁</span><span>Ingeniería<br />+ ejecución</span></div>
      <div><span class="trust-icon">⌖</span><span>Bogotá · Proyectos<br />en diferentes ciudades</span></div>
    </div>
  </section>

  <section class="about section section--light" id="nosotros">
    <div class="container about__grid">
      <div class="about__title" data-reveal>
        <p class="eyebrow">TICLAT / Nuestra visión</p>
        <h2>Ingeniería que convierte planos en <em>espacios listos para operar.</em></h2>
      </div>
      <div class="about__copy" data-reveal>
        <p class="lead">Integramos conocimiento técnico, planeación y ejecución para desarrollar infraestructura eléctrica confiable en proyectos comerciales, empresariales e industriales.</p>
        <p>Nuestro trabajo comienza mucho antes de encender una luz. Coordinamos materiales, personal, instalaciones, redes y procesos para que cada espacio pueda entrar en operación de manera segura y organizada.</p>
        <a class="text-link" href="#servicios">Conoce nuestra forma de trabajar <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="container about__principles" data-reveal>
      <span>01 / Ingeniería</span><span>02 / Infraestructura</span><span>03 / Ejecución</span><span>04 / Confianza</span>
    </div>
  </section>

  <section class="services section section--white" id="servicios">
    <div class="container">
      <div class="section-heading section-heading--split" data-reveal>
        <div><p class="eyebrow">Capacidades / 06</p><h2>Todo lo necesario para llevar un proyecto a <em>ejecución.</em></h2></div>
        <p>Soluciones técnicas adaptadas a las necesidades y características de cada espacio.</p>
      </div>
      <div class="service-grid">
        {services.map((service) => (
          <article class="service-card" data-reveal>
            <div class="service-card__media">
              <Image src={service.image} alt={service.title} widths={[480, 720]} sizes="(max-width: 620px) 100vw, (max-width: 980px) 50vw, 33vw" format="webp" quality={78} loading="lazy" />
            </div>
            <div class="service-card__body">
              <div class="service-card__top"><span class="service-card__number">{service.number}</span><span class="service-card__arrow" aria-hidden="true">↗</span></div>
              <svg class="service-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={service.icon} /></svg>
              <h3>{service.title}</h3>
              <p>{service.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="process section section--navy">
    <div class="process__glow" aria-hidden="true"></div>
    <div class="container">
      <div class="section-heading section-heading--light" data-reveal>
        <div><p class="eyebrow">Nuestra forma de trabajar</p><h2>De la planeación a la <em>puesta en operación.</em></h2></div>
        <p>Cada proyecto necesita una ruta clara. Coordinamos las decisiones que hacen que la ejecución avance con orden.</p>
      </div>
      <div class="process__timeline">
        {process.map((step) => (
          <article class="process-step" data-reveal>
            <span class="process-step__number">{step.number}</span>
            <span class="process-step__line" aria-hidden="true"></span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="projects section section--light" id="proyectos">
    <div class="container">
      <div class="section-heading section-heading--split" data-reveal>
        <div><p class="eyebrow">Nuestro trabajo / 03</p><h2>Proyectos que <em>cobran vida.</em></h2></div>
        <p>Cada apertura es el resultado de muchas decisiones, coordinación y trabajo técnico. Estos son algunos proyectos en los que TICLAT ha participado.</p>
      </div>
      <div class="project-grid">
        {projects.map((project) => (
          <article class:list={["project-card", project.size]} data-reveal>
            <Image src={project.image} alt={project.title} widths={[640, 960, 1280]} sizes="(max-width: 720px) 100vw, 50vw" format="webp" quality={78} />
            <div class="project-card__veil"></div>
            <div class="project-card__content">
              <p class="project-card__category">{project.category}</p>
              <h3>{project.title}</h3>
              <div class="project-card__meta"><span>{project.location}</span><span aria-hidden="true">↗</span></div>
              <p class="project-card__text">{project.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="statement section section--white">
    <div class="container statement__grid">
      <div class="statement__media" data-reveal>
        <Image src={spaceImage} alt="Espacio comercial terminado e iluminado" widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 50vw" format="webp" quality={78} />
        <span class="image-stamp">TICLAT / 2015 — 2026</span>
      </div>
      <div class="statement__copy" data-reveal>
        <p class="eyebrow">El resultado</p>
        <h2>Nuestro trabajo está detrás de espacios que todos los días <em>reciben personas.</em></h2>
        <p>Una infraestructura bien ejecutada no siempre se ve. Pero está presente cada vez que una tienda enciende sus luces, abre sus puertas y comienza a operar.</p>
        <a class="text-link" href="#contacto">Hablemos de tu próximo proyecto <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="safety section section--sand">
    <div class="container safety__grid">
      <div class="safety__copy" data-reveal>
        <p class="eyebrow">Seguridad / Atención al detalle</p>
        <h2>La ejecución <em>técnica</em> importa.</h2>
        <p>Cada proyecto requiere organización, conocimiento técnico y atención al detalle. Trabajamos siguiendo los requerimientos definidos para cada obra y aplicando buenas prácticas de instalación y seguridad durante su ejecución.</p>
        <div class="safety__signature"><span class="signature-line"></span><span>Calidad de instalación<br />en cada detalle</span></div>
      </div>
      <div class="safety__media" data-reveal>
        <Image src={engineeringImage} alt="Equipo de ingeniería revisando una instalación" widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 50vw" format="webp" quality={78} />
        <div class="safety__badge"><span>01</span><strong>Seguridad<br />primero</strong></div>
      </div>
    </div>
  </section>

  <section class="contact section section--blue" id="contacto">
    <div class="contact__blueprint" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    <div class="container contact__grid">
      <div class="contact__intro" data-reveal>
        <p class="eyebrow eyebrow--light">Tu próximo proyecto puede empezar aquí</p>
        <h2>Hablemos de la infraestructura que necesitas <em>construir.</em></h2>
        <p>Cuéntanos sobre tu proyecto y nuestro equipo podrá ayudarte a evaluar sus necesidades técnicas y de ejecución.</p>
        <div class="contact__facts"><span>Bogotá D.C. · Colombia</span><span>NIT 900858320-1</span></div>
      </div>
      <form class="contact-form" data-contact-form data-reveal>
        <div class="contact-form__top"><span>Solicitar cotización</span><span>01 / 03</span></div>
        <label>Nombre o empresa<input type="text" name="name" placeholder="¿Con quién tenemos el gusto?" required /></label>
        <label>Correo electrónico<input type="email" name="email" placeholder="nombre@empresa.com" required /></label>
        <label>Cuéntanos sobre el proyecto<textarea name="message" rows="3" placeholder="Tipo de espacio, ciudad y necesidades..." required></textarea></label>
        <button class="button button--accent" type="submit">Enviar solicitud <span aria-hidden="true">↗</span></button>
        <p class="form-status" data-form-status role="status"></p>
      </form>
    </div>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
    const status = document.querySelector<HTMLElement>("[data-form-status]");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (status) status.textContent = "Gracias. Hemos recibido tu solicitud.";
      form.reset();
    });
  </script>
</Layout>
