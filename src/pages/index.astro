---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import heroImage from "../assets/images/ticlat-hero-campus.webp";
import engineeringImage from "../assets/images/ticlat-engineering.jpg";
import spaceImage from "../assets/images/ticlat-space.jpg";
import installationsImage from "../assets/images/ticlat-installations.jpg";
import networkImage from "../assets/images/ticlat-network.jpg";
import maintenanceImage from "../assets/images/ticlat-maintenance.jpg";
import teamImage from "../assets/images/ticlat-team.jpg";
import serviceInstallationsImage from "../assets/images/service-installations.webp";
import serviceRetailImage from "../assets/images/service-retail.webp";
import serviceNetworkImage from "../assets/images/service-network.webp";
import serviceEngineeringImage from "../assets/images/service-engineering.webp";
import serviceMaintenanceImage from "../assets/images/service-maintenance.webp";
import serviceProjectsImage from "../assets/images/service-projects.webp";
import minisoProjectImage from "../assets/images/project-miniso-100.webp";
import statementMinisoImage from "../assets/images/statement-miniso.webp";
import safetyTeamImage from "../assets/images/safety-team.webp";
import engineeringIconImage from "../assets/images/icon-engineering.webp";
import mapIconImage from "../assets/images/icon-map.webp";
import projectIconImage from "../assets/images/icon-project.webp";
import serviceArrowIcon from "../assets/images/service-arrow.png";
import quoteInvertedIcon from "../assets/images/icon-quote-inverted.png";
import serviceInstallationPdfImage from "../assets/images/service-installation-pdf.webp";
import serviceMaintenancePdfImage from "../assets/images/service-maintenance-pdf.webp";
import serviceComplementaryPdfImage from "../assets/images/service-complementary-pdf.webp";
import serviceCablingPdfImage from "../assets/images/service-cabling-pdf.webp";
import serviceCctvPdfImage from "../assets/images/service-cctv-pdf.webp";
import serviceLocativePdfImage from "../assets/images/service-locative-pdf.webp";
import serviceMobilityPdfImage from "../assets/images/service-mobility-pdf.webp";
import clientD1 from "../assets/images/clients/d1.png";
import clientTitularizadora from "../assets/images/clients/titularizadora.png";
import clientHerbalife from "../assets/images/clients/herbalife.png";
import clientMarca from "../assets/images/clients/marca.png";
import clientColgas from "../assets/images/clients/colgas.png";
import clientCredibanco from "../assets/images/clients/credibanco.png";
import clientGlass from "../assets/images/clients/glass-protection.png";
import clientGyl from "../assets/images/clients/gyl.png";
import clientDisenos from "../assets/images/clients/disenos-construcciones.png";
import clientUnidad from "../assets/images/clients/unidad-medica.png";
import clientAcomedica from "../assets/images/clients/acomedica.png";

const services = [
  {
    number: "01",
    title: "Instalaciones eléctricas",
    text: "Ejecutamos infraestructura eléctrica para proyectos comerciales, empresariales e industriales, desde la canalización hasta la puesta en funcionamiento.",
    image: serviceInstallationsImage,
    icon: "M12 3v18M5 7h14M5 17h14M7 7v10M17 7v10",
  },
  {
    number: "02",
    title: "Infraestructura para retail",
    text: "Acompañamos adecuaciones, aperturas y remodelaciones, coordinando la infraestructura que cada espacio necesita para entrar en operación.",
    image: serviceRetailImage,
    icon: "M4 20V8l8-5 8 5v12M8 20v-6h8v6M3 20h18",
  },
  {
    number: "03",
    title: "Redes y cableado",
    text: "Implementamos canalizaciones, bandejas, cableado e infraestructura física para redes de comunicación y datos.",
    image: serviceNetworkImage,
    icon: "M5 12h14M12 5v14M7 7l10 10M17 7 7 17",
  },
  {
    number: "04",
    title: "Ingeniería y planeación",
    text: "Analizamos requerimientos, planos, materiales y condiciones de ejecución para transformar necesidades en proyectos organizados.",
    image: serviceEngineeringImage,
    icon: "M5 19 19 5M6 6h.01M18 18h.01M7 17h10M7 7h4",
  },
  {
    number: "05",
    title: "Adecuaciones y mantenimiento",
    text: "Intervenimos, ampliamos, reorganizamos y mantenemos infraestructura para conservar los espacios seguros y operativos.",
    image: serviceMaintenanceImage,
    icon: "M14.5 6.5a4 4 0 0 0-5 5L4 17l3 3 5.5-5.5a4 4 0 0 0 5-5L15 12l-3-3 2.5-2.5Z",
  },
  {
    number: "06",
    title: "Acompañamiento de proyectos",
    text: "Coordinamos las etapas de ejecución con seguimiento técnico, control de actividades y comunicación permanente.",
    image: serviceProjectsImage,
    icon: "M4 6h16M4 12h16M4 18h10M8 3v6M16 9v6M10 15v6",
  },
];

const clients = [
  { name: "D1", image: clientD1 },
  { name: "Titularizadora Colombiana", image: clientTitularizadora },
  { name: "Herbalife", image: clientHerbalife },
  { name: "Marca Organización Inmobiliaria", image: clientMarca },
  { name: "Colgas", image: clientColgas },
  { name: "Credibanco", image: clientCredibanco },
  { name: "Glass Protection", image: clientGlass },
  { name: "G&L", image: clientGyl },
  { name: "Diseños y Construcciones", image: clientDisenos },
  { name: "Unidad Médica Nueva Clínica del Country", image: clientUnidad },
  { name: "Acomedica", image: clientAcomedica },
];
const carouselClients = [...clients, ...clients.slice(0, 4)];

const serviceCategories = [
  { title: "Instalaciones eléctricas", intro: "Diseñamos, construimos y mantenemos sistemas eléctricos confiables para cada espacio.", image: serviceInstallationPdfImage.src, items: ["Diseño y construcción de redes eléctricas de baja y media tensión", "Tableros de distribución normales y regulados", "Diseño e instalación de iluminación interior y exterior", "Sistemas de malla y puesta a tierra", "Instalación de UPS y tableros especiales", "Diseño y montaje de cerramientos electrificados"] },
  { title: "Infraestructura para retail", intro: "Acompañamos aperturas, adecuaciones y remodelaciones para poner cada tienda en operación.", image: serviceRetailImage.src, items: ["Planeación de necesidades eléctricas del local", "Coordinación de obra y proveedores en sitio", "Adecuación de iluminación, tableros y canalizaciones", "Puesta en marcha y acompañamiento de apertura"] },
  { title: "Redes y cableado", intro: "Construimos la infraestructura física que conecta voz, datos y sistemas inalámbricos.", image: serviceCablingPdfImage.src, items: ["Cableado estructurado categoría 5E, 6, 6A y 7", "Instalación de canaleta, tubería y bandejas portacables", "Instalación de centros de cómputo, gabinetes y racks", "Instalación de redes inalámbricas", "Certificación de cableado estructurado"] },
  { title: "Ingeniería y planeación", intro: "Convertimos requerimientos, planos y materiales en proyectos ordenados y ejecutables.", image: serviceEngineeringImage.src, items: ["Levantamiento técnico y diagnóstico del espacio", "Diseño de planos y especificaciones eléctricas", "Planeación de actividades, recursos y materiales", "Presupuestos, cronogramas y coordinación de ejecución"] },
  { title: "Adecuaciones y mantenimiento", intro: "Intervenimos y mantenemos la infraestructura para conservar espacios seguros y operativos.", image: serviceMaintenanceImage.src, items: ["Adecuaciones y ampliaciones de instalaciones", "Reorganización de tableros y circuitos", "Mantenimiento preventivo y correctivo", "Atención de contingencias y problemas operativos"] },
  { title: "Acompañamiento de proyectos", intro: "Coordinamos cada etapa con seguimiento técnico, control de actividades y comunicación permanente.", image: serviceProjectsImage.src, items: ["Seguimiento de avances y calidad de ejecución", "Coordinación entre equipos, contratistas y operación", "Verificación de entregables y puesta en servicio", "Acompañamiento durante la apertura y operación"] },
  { title: "Mantenimiento eléctrico", intro: "Mantenemos los sistemas eléctricos disponibles y seguros, con respuesta prioritaria cuando surge una contingencia.", image: serviceMaintenancePdfImage.src, items: ["Mantenimiento preventivo y correctivo de emergencia", "Diagnóstico y solución de problemas operativos eléctricos", "Mantenimiento de sistemas de iluminación interiores y exteriores", "Medición y corrección de niveles de iluminación"] },
  { title: "Servicios complementarios", intro: "Complementamos la ejecución eléctrica con documentación, inspección y cumplimiento normativo.", image: serviceComplementaryPdfImage.src, items: ["Levantamiento y diseño de planos eléctricos", "Acompañamiento en visitas de inspección y cierre", "Apoyo en procesos de certificación de cumplimiento RETIE", "Solución y corrección de no conformidades eléctricas"] },
  { title: "CCTV y seguridad electrónica", intro: "Integramos soluciones de monitoreo y protección para instalaciones comerciales y empresariales.", image: serviceCctvPdfImage.src, items: ["Sistemas de circuito cerrado de televisión", "Seguridad perimetral e interna", "Diseño de cobertura y ubicación de cámaras", "Integración con la infraestructura eléctrica y de datos"] },
  { title: "Mantenimiento locativo", intro: "Conservamos los espacios en buen estado para que puedan operar con seguridad y continuidad.", image: serviceLocativePdfImage.src, items: ["Reparaciones y mantenimiento locativo", "Construcción y remodelación de obras menores", "Instalación de techo PVC y drywall", "Adecuaciones coordinadas con la operación del espacio"] },
  { title: "Energías limpias", intro: "Evaluamos alternativas de generación y eficiencia para reducir el impacto y optimizar el consumo.", image: serviceEngineeringImage.src, items: ["Diagnóstico de oportunidades de eficiencia energética", "Diseño de soluciones de generación distribuida", "Integración con tableros y redes existentes", "Acompañamiento técnico para implementación"] },
  { title: "Movilidad eléctrica", intro: "Preparamos la infraestructura necesaria para incorporar vehículos eléctricos de forma segura.", image: serviceMobilityPdfImage.src, items: ["Asesoría y diseño para instalación del cargador", "Instalación de cargadores eléctricos", "Adecuación de circuitos y protecciones", "Verificación y puesta en operación"] },
];

const additionalServices = [
  { number: "07", title: "Mantenimiento eléctrico", text: "Mantenemos los sistemas eléctricos disponibles y seguros, con respuesta prioritaria ante contingencias.", image: serviceMaintenancePdfImage, icon: "M4 7h16M4 12h16M4 17h16M8 4v16M16 4v16" },
  { number: "08", title: "Servicios complementarios", text: "Completamos la ejecución con levantamientos, inspecciones y acompañamiento para certificación RETIE.", image: serviceComplementaryPdfImage, icon: "M5 4h14v16H5zM8 8h8M8 12h8M8 16h5" },
  { number: "09", title: "CCTV y seguridad electrónica", text: "Integramos monitoreo, circuito cerrado y seguridad perimetral para proteger cada instalación.", image: serviceCctvPdfImage, icon: "M3 8h18v10H3zM8 8l2-3h4l2 3M12 12v2" },
  { number: "10", title: "Mantenimiento locativo", text: "Conservamos y adecuamos los espacios para que operen con seguridad y continuidad.", image: serviceLocativePdfImage, icon: "M4 20V9l8-5 8 5v11M8 20v-6h8v6M3 20h18" },
  { number: "11", title: "Energías limpias", text: "Evaluamos alternativas de eficiencia y generación para optimizar el consumo energético.", image: serviceEngineeringImage, icon: "M13 2L3 14h9l-1 8 10-12h-9z" },
  { number: "12", title: "Movilidad eléctrica", text: "Preparamos la infraestructura para incorporar cargadores de vehículos eléctricos de forma segura.", image: serviceMobilityPdfImage, icon: "M5 17h14l-1-8H6zM8 17v3M16 17v3M7 9l1-4h8l1 4M8 13h.01M16 13h.01" },
];
const allServices = [...services, ...additionalServices];
const serviceSlides = Array.from({ length: Math.ceil(allServices.length / 6) }, (_, slide) => allServices.slice(slide * 6, slide * 6 + 6));

const projects = [
  {
    title: "MINISO — Tienda #100 Colombia",
    location: "Ibagué, Colombia",
    category: "Retail · Infraestructura eléctrica",
    text: "Participación en la ejecución de la obra eléctrica correspondiente a la apertura de la tienda número 100 de MINISO en Colombia.",
    image: minisoProjectImage,
    size: "project-card--large",
  },
  {
    title: "MINISO Parque Alegra",
    location: "Barranquilla, Colombia",
    category: "Retail · Instalaciones eléctricas",
    text: "Proyecto de infraestructura eléctrica desarrollado para un nuevo espacio comercial.",
    image: engineeringImage,
    size: "",
  },
  {
    title: "D1 86 Once",
    location: "Bogotá, Colombia",
    category: "Retail · Instalaciones eléctricas",
    text: "Instalaciones eléctricas desarrolladas para la adecuación de un espacio comercial.",
    image: spaceImage,
    size: "",
  },
];

const process = [
  { number: "01", title: "Entendemos", text: "Analizamos el proyecto, el espacio y sus requerimientos técnicos." },
  { number: "02", title: "Planeamos", text: "Definimos recursos, actividades, materiales y condiciones de ejecución." },
  { number: "03", title: "Ejecutamos", text: "Desarrollamos las instalaciones con seguimiento técnico y coordinación." },
  { number: "04", title: "Verificamos", text: "Revisamos la correcta terminación y funcionamiento de lo ejecutado." },
  { number: "05", title: "Entregamos", text: "Dejamos la infraestructura preparada para acompañar la operación." },
];
---

<Layout>
  <section class="hero" id="inicio">
    <Image
      src={heroImage}
      alt="Vestíbulo de edificio empresarial con iluminación e infraestructura eléctrica"
      class="hero__image"
      widths={[768, 1280, 1672]}
      sizes="100vw"
      format="webp"
      quality={78}
      loading="eager"
    />
    <div class="hero__overlay"></div>
    <div class="hero__technical" aria-hidden="true">
      <span>BOG / 04°42'N</span>
      <span class="hero__technical-line"></span>
      <span>2025 — 2026</span>
    </div>
    <div class="hero__rail" aria-hidden="true"><span>INGENIERÍA</span><span>INFRAESTRUCTURA</span><span>EJECUCIÓN</span><span>CONFIANZA</span></div>

    <div class="container hero__content">
      <div class="hero__eyebrow"><span class="status-dot"></span> Ingeniería e infraestructura eléctrica</div>
      <h1>Infraestructura<br /><em>que hace posible</em><br />cada proyecto.</h1>
      <p class="hero__intro">Desarrollamos soluciones eléctricas y de infraestructura para espacios comerciales, empresariales e industriales, acompañando cada proyecto desde la planeación hasta su ejecución.</p>
      <div class="hero__actions">
        <a class="button button--accent" href="#contacto">Cotiza tu proyecto <Image class="quote-icon-inverted" src={quoteInvertedIcon} alt="" width={48} height={48} /></a>
        <a class="text-link text-link--light" href="#proyectos">Ver proyectos <span aria-hidden="true">↓</span></a>
      </div>
    </div>

  </section>

  <section class="trust-strip" aria-label="Experiencia y alcance de Ticlat">
    <div class="container trust-strip__inner">
      <div><span class="trust-strip__number">10+</span><span>años desarrollando<br />infraestructura</span></div>
      <div><Image class="trust-icon-image" src={projectIconImage} alt="" width={44} height={44} /><span>Proyectos comerciales<br />y empresariales</span></div>
      <div><Image class="trust-icon-image" src={engineeringIconImage} alt="" width={44} height={44} /><span>Ingeniería<br />+ ejecución</span></div>
      <div><Image class="trust-icon-image" src={mapIconImage} alt="" width={44} height={44} /><span>Bogotá · Proyectos<br />en diferentes ciudades</span></div>
    </div>
  </section>

  <section class="about section section--light" id="nosotros">
    <div class="container about__grid">
      <div class="about__title" data-reveal>
        <p class="eyebrow">TICLAT / Nuestra visión</p>
        <h2>Ingeniería que convierte planos en <em>espacios listos para operar.</em></h2>
      </div>
      <div class="about__copy" data-reveal>
        <p class="lead">Integramos conocimiento técnico, planeación y ejecución para desarrollar infraestructura eléctrica confiable en proyectos comerciales, empresariales e industriales.</p>
        <p>Nuestro trabajo comienza mucho antes de encender una luz. Coordinamos materiales, personal, instalaciones, redes y procesos para que cada espacio pueda entrar en operación de manera segura y organizada.</p>
        <a class="text-link" href="#servicios">Conoce nuestra forma de trabajar <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="clients-strip" aria-label="Clientes TICLAT">
    <div class="container">
      <div class="clients-strip__head"><p class="eyebrow">Clientes</p><p>Empresas que confían en nuestra infraestructura.</p></div>
      <div class="clients-carousel" data-client-carousel>
        <div class="clients-carousel__fade clients-carousel__fade--left" aria-hidden="true"></div>
        <div class="clients-track" data-client-track>
          {carouselClients.map((client, index) => <div class="client-logo"><Image src={client.image} alt={client.name} width={220} height={110} loading={index > 4 ? "lazy" : "eager"} /></div>)}
        </div>
        <div class="clients-carousel__fade clients-carousel__fade--right" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <section class="services section section--white" id="servicios">
    <div class="container">
      <div class="section-heading section-heading--split" data-reveal>
        <div><p class="eyebrow">Capacidades</p><h2>Todo lo necesario para llevar un proyecto a <em>ejecución.</em></h2></div>
        <p>Soluciones técnicas adaptadas a las necesidades y características de cada espacio.</p>
      </div>
      <div class="service-tabs" role="tablist" aria-label="Categorías de servicios">
        {serviceCategories.map((category, index) => (
          <button class="service-tab" class:service-tab--active={index === 0} type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} data-service-tab={index}>{category.title}</button>
        ))}
      </div>
      <div class="service-carousel" data-service-carousel>
        <button class="service-carousel__button service-carousel__button--prev" type="button" data-service-prev aria-label="Servicios anteriores"><Image src={serviceArrowIcon} alt="" width={42} height={42} /></button>
        <div class="service-carousel__viewport">
          <div class="service-carousel__track" data-service-track>
            {serviceSlides.map((slide) => (
              <div class="service-grid service-carousel__slide">
                {slide.map((service, index) => (
                  <article class="service-card" data-reveal>
                    <div class="service-card__media">
                      <Image src={service.image} alt={service.title} widths={[480, 720]} sizes="(max-width: 620px) 100vw, (max-width: 980px) 50vw, 33vw" format="webp" quality={78} loading="lazy" />
                    </div>
                    <div class="service-card__body">
                      <svg class="service-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={service.icon} /></svg>
                      <h3>{service.title}</h3>
                      <p>{service.text}</p>
                      <button class="service-card__details" type="button" data-service-open={serviceSlides.indexOf(slide) * 6 + index}>Ver detalles <span aria-hidden="true">↗</span></button>
                    </div>
                  </article>
                ))}
              </div>
            ))}
          </div>
        </div>
        <button class="service-carousel__button service-carousel__button--next" type="button" data-service-next aria-label="Más servicios"><Image src={serviceArrowIcon} alt="" width={42} height={42} /></button>
      </div>
      <dialog class="service-dialog" data-service-dialog aria-labelledby="service-dialog-title">
        <button class="service-dialog__close" type="button" data-service-close aria-label="Cerrar detalles">×</button>
        <p class="eyebrow">Servicio TICLAT</p>
        <img class="service-dialog__image" data-service-dialog-image alt="" />
        <h3 id="service-dialog-title" data-service-dialog-title></h3>
        <p class="service-dialog__intro" data-service-dialog-intro></p>
        <ul data-service-dialog-items></ul>
        <a class="button button--accent" href="#contacto" data-service-dialog-contact>Hablemos de tu proyecto <span aria-hidden="true">↗</span></a>
      </dialog>
    </div>
  </section>

  <section class="process section section--navy">
    <div class="process__glow" aria-hidden="true"></div>
    <div class="container">
      <div class="section-heading section-heading--light" data-reveal>
        <div><p class="eyebrow">Nuestra forma de trabajar</p><h2>De la planeación a la <em>puesta en operación.</em></h2></div>
        <p>Cada proyecto necesita una ruta clara. Coordinamos las decisiones que hacen que la ejecución avance con orden.</p>
      </div>
      <div class="process__timeline">
        {process.map((step) => (
          <article class="process-step" data-reveal>
            <span class="process-step__number">{step.number}</span>
            <span class="process-step__line" aria-hidden="true"></span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="projects section section--light" id="proyectos">
    <div class="container">
      <div class="section-heading section-heading--split" data-reveal>
        <div><p class="eyebrow">Nuestro trabajo</p><h2>Proyectos que <em>cobran vida.</em></h2></div>
        <p>Cada apertura es el resultado de muchas decisiones, coordinación y trabajo técnico. Estos son algunos proyectos en los que TICLAT ha participado.</p>
      </div>
      <div class="project-grid">
        {projects.map((project) => (
          <article class:list={["project-card", project.size]} data-reveal>
            <Image src={project.image} alt={project.title} widths={[640, 960, 1280]} sizes="(max-width: 720px) 100vw, 50vw" format="webp" quality={78} />
            <div class="project-card__veil"></div>
            <div class="project-card__content">
              <p class="project-card__category">{project.category}</p>
              <h3>{project.title}</h3>
              <div class="project-card__meta"><span>{project.location}</span><span aria-hidden="true">↗</span></div>
              <p class="project-card__text">{project.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="statement section section--white">
    <div class="container statement__grid">
      <div class="statement__media" data-reveal>
        <span class="image-tape" aria-hidden="true"></span>
        <Image src={statementMinisoImage} alt="Tienda MINISO terminada e iluminada" widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 50vw" format="webp" quality={78} />
        <span class="image-stamp">TICLAT / 2015 — 2026</span>
      </div>
      <div class="statement__copy" data-reveal>
        <p class="eyebrow">El resultado</p>
        <h2>Nuestro trabajo está detrás de espacios que todos los días <em>reciben personas.</em></h2>
        <p>Una infraestructura bien ejecutada no siempre se ve. Pero está presente cada vez que una tienda enciende sus luces, abre sus puertas y comienza a operar.</p>
        <a class="text-link" href="#contacto">Hablemos de tu próximo proyecto <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="safety section section--sand">
    <div class="container safety__grid">
      <div class="safety__copy" data-reveal>
        <p class="eyebrow">Seguridad / Atención al detalle</p>
        <h2>La ejecución <em>técnica</em> importa.</h2>
        <p>Cada proyecto requiere organización, conocimiento técnico y atención al detalle. Trabajamos siguiendo los requerimientos definidos para cada obra y aplicando buenas prácticas de instalación y seguridad durante su ejecución.</p>
        <div class="safety__signature"><span class="signature-line"></span><span>Calidad de instalación<br />en cada detalle</span></div>
      </div>
      <div class="safety__media" data-reveal>
        <Image src={safetyTeamImage} alt="Equipo TICLAT revisando planos de una instalación" widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 50vw" format="webp" quality={78} />
        <div class="safety__badge"><span>01</span><strong>Seguridad<br />primero</strong></div>
      </div>
    </div>
  </section>

  <section class="contact section section--blue" id="contacto">
    <div class="contact__blueprint" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    <div class="container contact__grid">
      <div class="contact__intro" data-reveal>
        <p class="eyebrow eyebrow--light">Tu próximo proyecto puede empezar aquí</p>
        <h2>Hablemos de la infraestructura que necesitas <em>construir.</em></h2>
        <p>Cuéntanos sobre tu proyecto y nuestro equipo podrá ayudarte a evaluar sus necesidades técnicas y de ejecución.</p>
        <div class="contact__facts"><span>Bogotá D.C. · Colombia</span><span>NIT 900858320-1</span></div>
      </div>
      <form class="contact-form" data-contact-form data-reveal>
        <div class="contact-form__top"><span>Solicitar cotización</span></div>
        <label>Nombre o empresa<input type="text" name="name" placeholder="¿Con quién tenemos el gusto?" required /></label>
        <label>Correo electrónico<input type="email" name="email" placeholder="nombre@empresa.com" required /></label>
        <label>Cuéntanos sobre el proyecto<textarea name="message" rows="3" placeholder="Tipo de espacio, ciudad y necesidades..." required></textarea></label>
        <button class="button button--accent" type="submit">Enviar solicitud <span aria-hidden="true">↗</span></button>
        <p class="form-status" data-form-status role="status"></p>
      </form>
    </div>
  </section>

  <script define:vars={{ serviceCategories, serviceSlideCount: serviceSlides.length }}>
    const form = document.querySelector("[data-contact-form]");
    const status = document.querySelector("[data-form-status]");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (status) status.textContent = "Gracias. Hemos recibido tu solicitud.";
      form.reset();
    });

    const serviceData = serviceCategories;
    const serviceDialog = document.querySelector("[data-service-dialog]");
    const dialogTitle = serviceDialog?.querySelector("[data-service-dialog-title]");
    const dialogImage = serviceDialog?.querySelector("[data-service-dialog-image]");
    const dialogIntro = serviceDialog?.querySelector("[data-service-dialog-intro]");
    const dialogItems = serviceDialog?.querySelector("[data-service-dialog-items]");
    const openService = (index) => {
      const service = serviceData[index];
      if (!service || !serviceDialog || !dialogTitle || !dialogIntro || !dialogItems || !dialogImage) return;
      dialogImage.src = service.image || "";
      dialogImage.alt = service.title;
      dialogTitle.textContent = service.title;
      dialogIntro.textContent = service.intro;
      dialogItems.innerHTML = service.items.map((item) => `<li>${item}</li>`).join("");
      if (typeof serviceDialog.showModal === "function") serviceDialog.showModal();
      else serviceDialog.setAttribute("open", "");
    };
    document.querySelectorAll("[data-service-open], [data-service-tab]").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const index = Number(trigger.dataset.serviceOpen ?? trigger.dataset.serviceTab);
        openService(index);
        document.querySelectorAll("[data-service-tab]").forEach((tab) => {
          const active = Number(tab.dataset.serviceTab) === index;
          tab.classList.toggle("service-tab--active", active);
          tab.setAttribute("aria-selected", String(active));
        });
      });
    });
    const closeService = () => {
      if (!serviceDialog) return;
      if (typeof serviceDialog.close === "function") serviceDialog.close();
      else serviceDialog.removeAttribute("open");
    };
    serviceDialog?.querySelector("[data-service-close]")?.addEventListener("click", closeService);
    serviceDialog?.querySelector("[data-service-dialog-contact]")?.addEventListener("click", closeService);
    serviceDialog?.addEventListener("click", (event) => { if (event.target === serviceDialog) closeService(); });

    const serviceTrack = document.querySelector("[data-service-track]");
    let serviceSlide = 0;
    const updateServiceCarousel = () => {
      if (!serviceTrack) return;
      serviceTrack.style.transform = `translateX(-${serviceSlide * 100}%)`;
    };
    document.querySelector("[data-service-prev]")?.addEventListener("click", () => {
      serviceSlide = (serviceSlide - 1 + serviceSlideCount) % serviceSlideCount;
      updateServiceCarousel();
    });
    document.querySelector("[data-service-next]")?.addEventListener("click", () => {
      serviceSlide = (serviceSlide + 1) % serviceSlideCount;
      updateServiceCarousel();
    });

  </script>
</Layout>
