---
import PedritoGreeting from "./PedritoGreeting.astro";

interface Props {
  /** Phone in international format, digits only. */
  phone?: string;
  /** Prefilled message shown in WhatsApp's composer. */
  message?: string;
}

const {
  phone = "573125127158",
  message = "Hola TICLAT, me gustaría cotizar un proyecto.",
} = Astro.props;

const href = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<a
  class="whatsapp-fab"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escribir a TICLAT por WhatsApp"
>
  <PedritoGreeting />
  <span class="whatsapp-fab__surface">
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35Z"
    />
    <path
      fill="currentColor"
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.28-1.38a9.86 9.86 0 0 0 4.75 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.13h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.05-.2-.31a8.18 8.18 0 0 1-1.26-4.36c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.83 2.41a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.22-8.24 8.22Z"
    />
  </svg>
  </span>
</a>

<script>
  async function greetWithPedrito() {
    const button = document.querySelector<HTMLAnchorElement>(".whatsapp-fab");
    if (!button || button.dataset.greetingStarted) return;
    button.dataset.greetingStarted = "true";

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (reducedMotion.matches) return;

    // Start only after the artwork is ready, keeping WhatsApp available on failure.
    const artwork = [...button.querySelectorAll("image")]
      .map((image) => image.getAttribute("href"))
      .filter((src): src is string => Boolean(src));
    if (!artwork.length) return;
    try {
      await Promise.all(artwork.map((src) => {
        const preload = new Image();
        preload.src = src;
        return preload.decode();
      }));
    } catch {
      return;
    }
    if (!button.isConnected || reducedMotion.matches) return;
    button.classList.add("is-greeting");

    const finishGreeting = () => {
      button.classList.remove("is-greeting");
      reducedMotion.removeEventListener("change", finishGreeting);
      window.removeEventListener("pagehide", finishGreeting);
      window.clearTimeout(finishTimer);
    };
    reducedMotion.addEventListener("change", finishGreeting, { once: true });
    window.addEventListener("pagehide", finishGreeting, { once: true });
    const finishTimer = window.setTimeout(finishGreeting, 4600);
  }

  greetWithPedrito();
  document.addEventListener("astro:page-load", greetWithPedrito);
  window.addEventListener("pageshow", (event) => {
    if (!event.persisted) return;
    const button = document.querySelector<HTMLAnchorElement>(".whatsapp-fab");
    if (button) delete button.dataset.greetingStarted;
    greetWithPedrito();
  });
</script>

<style>
  .whatsapp-fab {
    position: fixed;
    right: clamp(16px, 3vw, 28px);
    bottom: clamp(16px, 3vw, 28px);
    z-index: 90;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    color: #fff;
  }

  .whatsapp-fab__surface {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: #25d366;
    box-shadow: 0 8px 24px rgba(7, 40, 30, 0.28);
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .whatsapp-fab__surface svg {
    width: 32px;
    height: 32px;
  }

  .whatsapp-fab:hover .whatsapp-fab__surface,
  .whatsapp-fab:focus-visible .whatsapp-fab__surface {
    background: #1fbb59;
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(7, 40, 30, 0.34);
  }

  .whatsapp-fab:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  .whatsapp-fab.is-greeting .whatsapp-fab__surface {
    animation: whatsapp-return 4.6s both;
  }

  @keyframes whatsapp-return {
    0% { opacity: 1; transform: scale(1); }
    12%, 79% { opacity: 0; transform: scale(0.3); }
    92% { opacity: 1; transform: scale(1.12); }
    100% { opacity: 1; transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-fab__surface { animation: none !important; transition: none; }
    .whatsapp-fab:hover .whatsapp-fab__surface { transform: none; }
  }

  @media (max-width: 600px) {
    .whatsapp-fab { width: 52px; height: 52px; }
    .whatsapp-fab__surface svg { width: 29px; height: 29px; }
  }
</style>
